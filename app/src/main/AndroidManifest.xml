<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wi-Fi scan results (Android 8.x gates these behind location) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Runtime location permission: required by Android 8.x for Wi-Fi/BLE scan results and GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Bluetooth classic permissions (Android 8.1 model; NOT the Android 12+ BLUETOOTH_SCAN/CONNECT) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- Declared for forward compatibility only; not required at targetSdk 27 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- All optional: app must run when hardware is missing/off -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- NOTE: INTERNET permission is intentionally absent (offline-first, docs/06 ADR-003). -->

    <application
        android:name=".App"
        android:label="S80 Spectrum Lab"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SurveyService"
            android:exported="false" />
    </application>
</manifest>
